# Kopieren nach .env und anpassen. .env ist per .gitignore ausgeschlossen.
# Beide Werte sind optional — ohne .env gelten die Defaults aus astro.config.mjs
# (GitHub Pages unter /jules-web-starter).

# Basis-URL der veröffentlichten Seite, ohne abschließenden Slash.
SITE_URL=https://jfk100611.github.io

# Unterpfad, unter dem die Seite liegt.
#   GitHub Pages Projektseite: /<repo-name>
#   eigene Domain oder lokal:  /
BASE_PATH=/jules-web-starter
